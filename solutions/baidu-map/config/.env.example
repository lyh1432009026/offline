# 离线百度地图 · 瓦片服务地址（拷到项目根目录，按环境改名 .env.production 等）

# 推荐：同域相对路径，由 Vite / Nginx 反向代理到内网瓦片服务
VITE_APP_MAP_TILES_URL = '/map-tiles'

# 备选：直接指向内网瓦片服务（注意浏览器与页面协议一致，HTTPS 页面不要写 HTTP）
# VITE_APP_MAP_TILES_URL = 'http://<瓦片服务地址>:<端口>/map'

# 说明：
# 1. 该变量由 vue/baiduMap.js 读取，注入 window.mapConfig.tiles_dir
# 2. 瓦片拼接规则为 {tiles_dir}/{z}/{x}/{y}.jpg，后缀由 mapConfig.imgext 决定
# 3. 不要写公网地图域名；纯离线环境不需要 AK
